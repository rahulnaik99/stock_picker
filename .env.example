# ── LLM ────────────────────────────────────────────────────────────────────
# Per-agent provider/model is set in app/service/models/model_config.json.
# These are only overrides / credentials.
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLMX_BASE_URL=http://127.0.0.1:8008/v1
OLMX_API_KEY=
LLM_TIMEOUT_SECONDS=300

# ── Market data (FYERS — the single source for candles + option chain) ──────
# Generate the daily access token with:  python -m scripts.fyers_login
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=

# ── Macro / rates ───────────────────────────────────────────────────────────
FRED_API_KEY=

# ── NSE (optional cookies/UA if your IP needs them) ─────────────────────────
NSE_COOKIES=
NSE_USER_AGENT=

# ── Premium financial news (stock.indianapi.in) ─────────────────────────────
# Tiny quota: 500 requests/month, 1 request/second. The pipeline fetches this
# MARKET-WIDE at most ONCE PER DAY and shares it across every stock/agent.
# Leave blank to use only the free Google-News source.
INDIANAPI_KEY=

# ── App behaviour ───────────────────────────────────────────────────────────
MCP_MODE=inprocess
ALWAYS_FRESH=1
MAX_CONCURRENT_STOCKS=3
