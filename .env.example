# Copy to .env and fill in. Only set what you use. Values are read at process start (restart after editing).

# ---------- LLM ----------
# Default is a LOCAL model via Ollama; no key needed. Models are chosen per agent in
# app/service/models/model_config.json. These are only global knobs / fallbacks.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_JSON_OBJECT=1
OLLAMA_NUM_CTX=16384               # Ollama's default (4096) is too small for the prompts
OLLAMA_MAX_CONCURRENT_REQUESTS=1
OLLAMA_MAX_RETRIES=0
LLM_TIMEOUT_SECONDS=120
# If your Ollama ignores the per-call num_ctx: OLLAMA_CONTEXT_LENGTH=16384 ollama serve  (or bake into a Modelfile).
OPENAI_API_KEY=
OLMX_BASE_URL=http://127.0.0.1:8008/v1
OLMX_API_KEY=

# ---------- Market data ----------
# FYERS v3 (candles + option chain) via the official fyers-apiv3 SDK; NO fallback. Token EXPIRES DAILY:
#   python -m scripts.fyers_login   (needs APP_ID, SECRET_ID, REDIRECT_URI from https://myapi.fyers.in/dashboard/)
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=

# FRED (free macro data): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# NSE is bot-protected. The app warms a session + sends a get-quote Referer, but if feeds still return
# unavailable/error (watch quarterly_fundamentals.last_fetch in the report), paste cookies + UA from your browser.
NSE_COOKIES=
NSE_USER_AGENT=

# ---------- App ----------
ALWAYS_FRESH=1                     # every live run refetches all tools (resets the day-gate at run start). 0 = once-a-day cache.
# MCP_MODE=inprocess
# MAX_CONCURRENT_STOCKS=3
# LOG_LEVEL=INFO
# FORCE_REFRESH=0
