# Copy to .env and fill in. Only set what you use. Values are read at process start (restart after editing).

# ---------- LLM ----------
# Default is a LOCAL model via Ollama; no key needed. Models are chosen per agent in
# app/service/models/model_config.json. These are only global knobs / fallbacks.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Local inference tuning (safe defaults shown):
LLM_JSON_OBJECT=1                  # ask Ollama/OLMX for a JSON object -> far fewer malformed-reply re-asks
OLLAMA_NUM_CTX=16384               # context window requested per call; Ollama's default (4096) is too small for the prompts
OLLAMA_MAX_CONCURRENT_REQUESTS=1   # keep at 1 for a big local model; 2 only if the GPU has headroom
OLLAMA_MAX_RETRIES=0
LLM_TIMEOUT_SECONDS=120            # raise if a large local model is slow on your hardware
# If your Ollama ignores the per-call num_ctx, start the server with: OLLAMA_CONTEXT_LENGTH=16384 ollama serve
# (or bake `PARAMETER num_ctx 16384` into a Modelfile — see app/config/ollama/).

# OpenAI (only if you switch model_config.json entries to provider "openai")
OPENAI_API_KEY=

# OLMX (OpenAI-compatible local server)
OLMX_BASE_URL=http://127.0.0.1:8008/v1
OLMX_API_KEY=

# ---------- Market data ----------
# FYERS v3 (candles + option chain). The ACCESS TOKEN EXPIRES DAILY: generate it with
#   python -m scripts.fyers_login
# which needs APP_ID, SECRET_ID and the REDIRECT_URI registered on your FYERS app
# (https://myapi.fyers.in/dashboard/). FYERS is optional — without it, candles fall back to Yahoo.
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=

# FRED (free macro data): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# NSE is bot-protected; if feeds return unavailable/error, paste cookies + UA from your browser.
NSE_COOKIES=
NSE_USER_AGENT=

# ---------- App ----------
# MCP_MODE=inprocess
# MAX_CONCURRENT_STOCKS=3
# LOG_LEVEL=INFO
# FORCE_REFRESH=0
